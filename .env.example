# BEAST_BOTS Environment Variables
# Copy this to .env.local and fill in your OAuth app credentials

# Meta (Facebook) App - used by MetaBot and InstagramBot
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret

# For other bots (add as you connect them)
# NOTION_CLIENT_ID=
# SLACK_CLIENT_ID=
# LINEAR_CLIENT_ID=

# Vercel Postgres (for future token storage)
# DATABASE_URL=

# Optional: Encryption key for token vault (AES-256)
# TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key
