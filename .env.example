# BEAST_BOTS Environment Variables
# Copy this to .env.local and fill in your credentials

# Clerk Authentication (required for user accounts & multi-user support)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Meta (Facebook) App - used by MetaBot and InstagramBot
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret

# For other bots (add as you connect them)
# NOTION_CLIENT_ID=
# SLACK_CLIENT_ID=
# LINEAR_CLIENT_ID=

# Vercel Postgres (for token storage)
DATABASE_URL=postgresql://user:pass@host:5432/beastbots

# Optional: Encryption key for token vault (AES-256)
# TOKEN_ENCRYPTION_KEY=your_32_byte_hex_key
